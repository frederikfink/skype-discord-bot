DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_GUILD_ID=

# SQLite file path (relative paths resolve from the repo root).
# Local dev uses ./data/bot.db — often empty if the bot runs on Railway.
# After `pnpm db:sync-prod`, point at the downloaded copy:
# DATABASE_PATH=./data/bot-prod.db
DATABASE_PATH=./data/bot.db

TIMEZONE=Europe/Copenhagen

# Music: FFmpeg is bundled in apps/bot Dockerfile.
# Optional — required for YouTube on many cloud hosts (Railway). Paste the browser Cookie header for youtube.com.
# YOUTUBE_COOKIES=
