DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_GUILD_ID=

# SQLite file path (relative paths resolve from the repo root).
# Local dev uses ./data/bot.db — often empty if the bot runs on Railway.
# After `pnpm db:sync-prod`, point at the downloaded copy:
# DATABASE_PATH=./data/bot-prod.db
DATABASE_PATH=./data/bot.db

TIMEZONE=Europe/Copenhagen

# Music: FFmpeg is bundled in apps/bot Dockerfile.
# Optional — required for YouTube on many cloud hosts (Railway). Paste the browser Cookie header for youtube.com.
# YOUTUBE_COOKIES=
# Optional — SoundCloud on Railway if auto-discovery fails. From soundcloud.com network tab: client_id=... on api-v2 requests.
# SOUNDCLOUD_CLIENT_ID=

# Web app (local / Vercel): public Railway bot URL for Winamp — no trailing path except optional /radio
# BOT_RADIO_URL=https://your-bot.up.railway.app
# Optional shared secret (set the same BOT_RADIO_SECRET on the bot service)
# BOT_RADIO_SECRET=
