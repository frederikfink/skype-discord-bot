{
  "name": "skype-bot",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "dev:bot": "turbo dev --filter=@repo/bot",
    "dev:web": "turbo dev --filter=@repo/web",
    "deploy-commands": "turbo deploy-commands --filter=@repo/bot",
    "db:sync-prod": "bash scripts/sync-prod-db.sh"
  },
  "devDependencies": {
    "turbo": "^2.5.4"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.12.1"
}
